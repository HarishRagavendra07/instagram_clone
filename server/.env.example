# Leave MONGO_URI unset to use the embedded MongoDB (data saved in server/.data)
# MONGO_URI=mongodb://127.0.0.1:27017/instagram
# Required in production (NODE_ENV=production). Use a long random value, e.g.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me
PORT=4000
